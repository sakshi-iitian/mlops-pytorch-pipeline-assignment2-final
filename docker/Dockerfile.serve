FROM python:3.11-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY requirements/serve.txt /tmp/serve.txt
RUN pip install -r /tmp/serve.txt

FROM base AS serving
RUN useradd --create-home --uid 10001 appuser
COPY src/ /app/src/
RUN mkdir -p /app/checkpoints && chown -R appuser:appuser /app
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1
CMD ["uvicorn", "serve:app", "--app-dir", "/app/src", "--host", "0.0.0.0", "--port", "8080"]
